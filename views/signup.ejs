<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../static/styles/signup.css" />
  <title>SignUp</title>
</head>

<body>
  <section class="section signup-section">
    <div class="container signup-container">
      <div class="main">
        <input type="checkbox" id="chk" class="visually-hidden toggle-input" />

        <div class="signup">
          <form method="post" action="/signup">
            <h1 class="form-title">
              <label for="chk" class="toggle-label">Sign up</label>
            </h1>
            <div class="signup-username">
              <label class="field-label" for="signup-username">User name</label>
              <input id="signup-username" type="text" name="SignUpUsername" autocomplete="username"
                placeholder="User name" required />
            </div>
            <div class="signup-email">
              <label class="field-label" for="signup-email">Email</label>
              <input id="signup-email" type="email" name="SignUpEmail" autocomplete="email" placeholder="Email"
                required />
            </div>
            <div class="signup-password">
              <label class="field-label" for="signup-password">Password</label>
              <input id="signup-password" type="password" name="SignUpPassword" autocomplete="new-password"
                placeholder="Password" required />
            </div>
            <div>
              <input class="button" name="SignUpSubmit" type="submit" value="Sign up" />
            </div>
          </form>
        </div>
        <div class="login">
          <form method="post" action="/login">
            <h2 class="form-title">
              <label for="chk" class="toggle-label">Login</label>
            </h2>
            <div class="signup-email">
              <label class="field-label" for="login-email">Email</label>
              <input id="login-email" type="email" name="LoginEmail" autocomplete="email"
                placeholder="Enter your email" required />
            </div>
            <div class="signup-password">
              <label class="field-label" for="login-password">Password</label>
              <input id="login-password" type="password" name="LoginPassword" autocomplete="current-password"
                placeholder="Enter password" required />
            </div>
            <!-- <button href="/auth">Log In</button> -->
            <div>
              <input class="button" name="LoginSubmit" type="submit" value="Login" />
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</body>

</html>
