<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="../static/styles/partials/cookie-banner.css" />
  <link rel="stylesheet" href="../static/styles/signup.css" />
  <title data-i18n-document-title="document.signup">SignUp</title>
</head>

<body>
  <section class="section signup-section">
    <div class="container signup-container">
      <div class="main">
        <div class="auth-lang-switch" data-i18n-aria-label="lang.switcher" aria-label="Language switcher">
          <button class="auth-lang-button" type="button" data-lang-value="en" data-i18n="lang.en">EN</button>
          <button class="auth-lang-button" type="button" data-lang-value="zh" data-i18n="lang.zh">中文</button>
        </div>
        <input type="checkbox" id="chk" class="visually-hidden toggle-input" />

        <div class="signup">
          <form method="post" action="/signup">
            <div class="auth-tabs" data-i18n-aria-label="auth.mode" aria-label="Authentication mode">
              <label for="chk" class="auth-tab auth-tab-signup" data-i18n="signup.title">Sign up</label>
              <label for="chk" class="auth-tab auth-tab-login" data-i18n="login.title">Login</label>
            </div>
            <h1 class="form-title">
              <label for="chk" class="toggle-label" data-i18n="signup.title">Sign up</label>
            </h1>
            <p class="auth-panel-copy" data-i18n="signup.copy">Create an account to organize work, study, and personal tasks in one place.</p>
            <div class="signup-username">
              <label class="field-label" for="signup-username" data-i18n="signup.username">User name</label>
              <input id="signup-username" type="text" name="SignUpUsername" autocomplete="username"
                data-i18n-placeholder="signup.placeholder.username" placeholder="User name" required />
            </div>
            <div class="signup-email">
              <label class="field-label" for="signup-email" data-i18n="signup.email">Email</label>
              <input id="signup-email" type="email" name="SignUpEmail" autocomplete="email"
                data-i18n-placeholder="signup.placeholder.email" placeholder="Email" required />
            </div>
            <div class="signup-password">
              <label class="field-label" for="signup-password" data-i18n="signup.password">Password</label>
              <input id="signup-password" type="password" name="SignUpPassword" autocomplete="new-password"
                data-i18n-placeholder="signup.placeholder.password" placeholder="Password" required />
            </div>
            <div>
              <input class="button" name="SignUpSubmit" type="submit" data-i18n-value="signup.submit" value="Sign up" />
            </div>
          </form>
        </div>
        <div class="login">
          <form method="post" action="/login">
            <div class="auth-tabs" data-i18n-aria-label="auth.mode" aria-label="Authentication mode">
              <label for="chk" class="auth-tab auth-tab-signup" data-i18n="signup.title">Sign up</label>
              <label for="chk" class="auth-tab auth-tab-login" data-i18n="login.title">Login</label>
            </div>
            <h2 class="form-title">
              <label for="chk" class="toggle-label" data-i18n="login.title">Login</label>
            </h2>
            <p class="auth-panel-copy" data-i18n="login.copy">Welcome back. Pick your language, sign in, and continue from the latest task board state.</p>
            <div class="signup-email">
              <label class="field-label" for="login-email" data-i18n="login.email">Email</label>
              <input id="login-email" type="email" name="LoginEmail" autocomplete="email"
                data-i18n-placeholder="login.placeholder.email" placeholder="Enter your email" required />
            </div>
            <div class="signup-password">
              <label class="field-label" for="login-password" data-i18n="login.password">Password</label>
              <input id="login-password" type="password" name="LoginPassword" autocomplete="current-password"
                data-i18n-placeholder="login.placeholder.password" placeholder="Enter password" required />
            </div>
            <div>
              <input class="button" name="LoginSubmit" type="submit" data-i18n-value="login.submit" value="Login" />
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
  <%-include("../views/partials/cookie-banner.ejs") %>
  <script src="../static/js/i18n.js"></script>
  <script type="module" src="/static/js/site.js"></script>
</body>

</html>
