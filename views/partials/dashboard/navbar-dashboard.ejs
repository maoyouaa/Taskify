<header class="dashboard-header-navbar">
  <div class="dashboard-navbar-container">
    <nav class="dashboard-navbar-dashboard-navbar">
      <form action="#" class="dashboard-navbar-search-bar" role="search" aria-label="Dashboard search">
        <label class="sr-only" for="dashboard-search" data-i18n="dashboard.search">Search</label>
        <button type="submit" data-i18n-aria-label="dashboard.search" aria-label="Search dashboard">
          <i class="fas fa-search"></i>
        </button>
        <input id="dashboard-search" name="search" type="text" data-i18n-placeholder="dashboard.search" placeholder="Search" />
      </form>
      <div class="dashboard-navbar-dashboard-links">
        <ul class="dashboard-navbar-dashboard-navbar-links">
          <li>
            <div class="lang-switch dashboard-lang-switch" data-i18n-aria-label="lang.switcher" aria-label="Language switcher">
              <button class="lang-switch-button" type="button" data-lang-value="en" data-i18n="lang.en">EN</button>
              <button class="lang-switch-button" type="button" data-lang-value="zh" data-i18n="lang.zh">中文</button>
            </div>
          </li>
          <li>
            <a href="#" aria-label="Help">
              <i class="fa-regular fa-circle-question" aria-hidden="true"></i>
            </a>
          </li>
          <li>
            <a href="#" class="dashboard-navbar-bell-icon" aria-label="Notifications">
              <i class="far fa-bell" aria-hidden="true"></i>
            </a>
          </li>
          <li>
            <div class="dashboard-navbar-dropdown">
              <button
                type="button"
                class="dashboard-navbar-dropbtn"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-controls="dashboard-navbar-myDropdown"
              >
                <span data-i18n="dashboard.user">Lord Voldemort</span> <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="dashboard-navbar-myDropdown" class="dashboard-navbar-dropdown-content" role="menu">
                <a href="#" style="font-size: 16px;" role="menuitem" data-i18n="dashboard.profile">Profile</a>
                <form method="post" action="/logout" class="dashboard-navbar-dropdown-form">
                  <button
                    type="submit"
                    class="dashboard-navbar-dropdown-action"
                    role="menuitem"
                    data-i18n="dashboard.logout"
                  >
                    Log Out
                  </button>
                </form>
              </div>
            </div>
          </li>
          <li>
            <a href="#" aria-label="Open profile">
              <i class="fa-regular fa-user dashboard-navbar-link-img dashboard-navbar-profile-icon" aria-hidden="true"></i>
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</header>
<script>
const dropdownButton = document.querySelector(".dashboard-navbar-dropbtn");
const dropdownMenu = document.getElementById("dashboard-navbar-myDropdown");

function closeDashboardDropdown() {
  dropdownMenu.classList.remove("dashboard-navbar-show");
  dropdownButton.setAttribute("aria-expanded", "false");
}

function toggleDashboardDropdown() {
  const isOpen = dropdownMenu.classList.toggle("dashboard-navbar-show");
  dropdownButton.setAttribute("aria-expanded", String(isOpen));
}

dropdownButton.addEventListener("click", toggleDashboardDropdown);
dropdownButton.addEventListener("keydown", (event) => {
  if (event.key === "Escape") {
    closeDashboardDropdown();
    dropdownButton.focus();
  }
});

window.addEventListener("click", (event) => {
  if (!event.target.closest(".dashboard-navbar-dropdown")) {
    closeDashboardDropdown();
  }
});
</script>
